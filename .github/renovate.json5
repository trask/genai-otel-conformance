{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "customManagers": [
    {
      customType: 'regex',
      managerFilePatterns: ['/^versions\.env$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+WEAVER_VERSION=(?<currentValue>\\S+)',
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+SEMCONV_VERSION=(?<currentValue>\\S+)',
      ],
    },
  ],
  // Override default ignorePaths to remove **/tests/** and **/test/** so that
  // Renovate picks up dependency files under the tests/ directory.
  "ignorePaths": [
    "**/node_modules/**"
  ],
  "packageRules": [
    {
      description: 'Group all non-major Python dependency updates into a single PR',
      matchManagers: ['pip_requirements'],
      matchUpdateTypes: ['minor', 'patch', 'pin', 'digest'],
      groupName: 'python-minor',
    },
    {
      description: 'Group all non-major JS dependency updates into a single PR',
      matchManagers: ['npm'],
      matchUpdateTypes: ['minor', 'patch', 'pin', 'digest'],
      groupName: 'js-minor',
    },
    {
      description: 'Group all non-major Java dependency updates into a single PR',
      matchManagers: ['gradle'],
      matchUpdateTypes: ['minor', 'patch', 'pin', 'digest'],
      groupName: 'java-minor',
    },
    {
      description: 'Group all non-major .NET dependency updates into a single PR',
      matchManagers: ['nuget'],
      matchUpdateTypes: ['minor', 'patch', 'pin', 'digest'],
      groupName: 'dotnet-minor',
    },
    {
      groupName: 'github actions',
      matchManagers: [
        'github-actions',
      ],
      schedule: [
        '* * 2 * *', // monthly, on the 2nd
      ],
    },
  ],
  "labels": [
    "dependencies"
  ]
}
