{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  // Override default ignorePaths to remove **/tests/** and **/test/** so that
  // Renovate picks up dependency files under the tests/ directory.
  "ignorePaths": [
    "**/node_modules/**"
  ],
  "packageRules": [
    {
      groupName: 'github actions',
      matchManagers: [
        'github-actions',
      ],
      schedule: [
        '* * 2 * *', // monthly, on the 2nd
      ],
    },
  ],
  "labels": [
    "dependencies"
  ]
}
