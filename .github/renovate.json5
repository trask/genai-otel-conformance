{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "customManagers": [
    {
      customType: 'regex',
      managerFilePatterns: ['/^versions\.env$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+WEAVER_VERSION=(?<currentValue>\\S+)',
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+SEMCONV_VERSION=(?<currentValue>\\S+)',
      ],
    },
  ],
  // Override default ignorePaths to remove **/tests/** and **/test/** so that
  // Renovate picks up dependency files under the tests/ directory.
  "ignorePaths": [
    "**/node_modules/**"
  ],
  "packageRules": [
    {
      groupName: 'github actions',
      matchManagers: [
        'github-actions',
      ],
      schedule: [
        '* * 2 * *', // monthly, on the 2nd
      ],
    },
    {
      description: 'Python OpenTelemetry SDK packages',
      matchManagers: ['pip_requirements'],
      matchPackageNames: [
        'opentelemetry-**',
        '!opentelemetry-instrumentation**',
      ],
      groupName: 'python-opentelemetry',
    },
    {
      description: 'JS OpenTelemetry SDK packages',
      matchManagers: ['npm'],
      matchPackageNames: [
        '@opentelemetry/**',
        '!@opentelemetry/instrumentation**',
      ],
      groupName: 'js-opentelemetry',
    },
    {
      description: 'Java OpenTelemetry SDK packages',
      matchManagers: ['gradle'],
      matchPackageNames: [
        'io.opentelemetry**',
        '!io.opentelemetry.instrumentation**',
      ],
      groupName: 'java-opentelemetry',
    },
    {
      description: '.NET OpenTelemetry packages',
      matchManagers: ['nuget'],
      matchPackageNames: ['OpenTelemetry**'],
      groupName: 'dotnet-opentelemetry',
    },
    {
      description: 'Python OpenTelemetry instrumentation packages (OpenLLMetry + otel-python-contrib)',
      matchManagers: ['pip_requirements'],
      matchPackageNames: ['opentelemetry-instrumentation-**'],
      groupName: 'python-opentelemetry-instrumentation',
    },
    {
      description: 'Python OpenInference instrumentation packages',
      matchManagers: ['pip_requirements'],
      matchPackageNames: ['openinference-instrumentation-**'],
      groupName: 'python-openinference-instrumentation',
    },
    {
      description: 'JS Traceloop instrumentation packages',
      matchManagers: ['npm'],
      matchPackageNames: ['@traceloop/instrumentation-**'],
      groupName: 'js-traceloop-instrumentation',
    },
    {
      description: 'JS OpenTelemetry contrib instrumentation packages',
      matchManagers: ['npm'],
      matchPackageNames: ['@opentelemetry/instrumentation**'],
      groupName: 'opentelemetry-js-contrib',
    },
    {
      description: 'Python LlamaIndex packages',
      matchManagers: ['pip_requirements'],
      matchPackageNames: ['llama-index-**'],
      groupName: 'python-llamaindex',
    },
    {
      description: 'Python Google GenAI packages',
      matchManagers: ['pip_requirements'],
      matchPackageNames: ['google-genai', 'google-adk', 'google-cloud-aiplatform'],
      groupName: 'python-google-genai',
    },
  ],
  "labels": [
    "dependencies"
  ]
}
